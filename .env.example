# Copy this file to /etc/douyin-fire/douyin-fire.env and set real values.
# Never commit real cookies or put them in the Docker image.

HEADLESS=true
DEBUG=false
LOG_LEVEL=Info
MATCH_MODE=nickname
BROWSER_TIMEOUT=120000
FRIEND_LIST_WAIT_TIME=2000
TASK_RETRY_TIMES=3
HITOKOTO_TYPES=["文学","影视","诗词","哲学"]
MESSAGE_TEMPLATE=续火花

# One task entry per account. The corresponding cookie variable is named
# COOKIES_<unique_id in uppercase>.
TASKS=[]
# Example:
# TASKS=[{"unique_id":"account1","username":"示例账号","targets":["好友昵称"]}]
# COOKIES_ACCOUNT1=[{"name":"sessionid","value":"填入真实 Cookie","domain":".douyin.com","path":"/"}]
