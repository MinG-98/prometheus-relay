# Prometheus Relay web credentials. Keep this file mode 600 on the VPS.
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
# Fernet key used to encrypt Cookie data at rest. Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROMETHEUS_RELAY_COOKIE_KEY=replace-with-a-private-fernet-key
# Set true when the console is served through HTTPS. Use false only for local HTTP testing.
PROMETHEUS_RELAY_SESSION_COOKIE_SECURE=true
# Keep false for a staging web-only deployment until customer acceptance is complete.
PROMETHEUS_RELAY_SCHEDULER_ENABLED=true
