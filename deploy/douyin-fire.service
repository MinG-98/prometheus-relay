[Unit]
Description=Douyin Fire Docker task
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/douyin-fire
Environment=COMPOSE_PROJECT_NAME=douyin-fire
Environment=DOUYIN_ENV_FILE=/etc/douyin-fire/douyin-fire.env
ExecStartPre=/usr/bin/test -s /etc/douyin-fire/douyin-fire.env
ExecStart=/usr/bin/flock -n /run/lock/douyin-fire.lock /usr/bin/docker compose run --rm --no-deps douyin-fire
TimeoutStartSec=45min
TimeoutStopSec=60s
KillMode=control-group
StandardOutput=journal
StandardError=journal
