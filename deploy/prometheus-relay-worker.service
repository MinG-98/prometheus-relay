[Unit]
Description=Prometheus Relay one-shot task
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/prometheus-relay
Environment=COMPOSE_PROJECT_NAME=prometheus-relay
Environment=PROMETHEUS_RELAY_ENV_FILE=/etc/prometheus-relay/web.env
ExecStartPre=/usr/bin/test -s /etc/prometheus-relay/web.env
ExecStart=/usr/bin/flock -n /run/lock/prometheus-relay.lock /usr/bin/docker compose run --rm --no-deps worker
TimeoutStartSec=45min
TimeoutStopSec=60s
KillMode=control-group
StandardOutput=journal
StandardError=journal
