[Unit]
Description=Prometheus Relay web console
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/prometheus-relay
Environment=COMPOSE_PROJECT_NAME=prometheus-relay
Environment=PROMETHEUS_RELAY_ENV_FILE=/etc/prometheus-relay/web.env
ExecStartPre=/usr/bin/test -s /etc/prometheus-relay/web.env
ExecStart=/usr/bin/docker compose up -d web
ExecStop=/usr/bin/docker compose stop web
TimeoutStartSec=5min
TimeoutStopSec=60s

[Install]
WantedBy=multi-user.target
